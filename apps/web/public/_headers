# Cloudflare Pages header overrides.
# GitHub Pages ignores this file; treat these as forward-compat if you move hosts.
# COOP/COEP aren't strictly required for this app (we don't use SharedArrayBuffer),
# but setting them keeps the door open for future WebCodecs/Worker upgrades.

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/wasm/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
