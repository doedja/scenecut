# Dependencies
node_modules/
yarn.lock
pnpm-lock.yaml

# Build output
dist/
build/
*.wasm
*.wasm.js

# Commit the prebuilt WASM at its serving location so CF Pages / GH Pages
# don't need emscripten in their build image. Regenerate when C src changes.
!apps/web/public/wasm/
!apps/web/public/wasm/detection.wasm
!apps/web/public/wasm/detection.wasm.js

# TypeScript
*.tsbuildinfo

# Testing
coverage/
.nyc_output/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.claude/
CLAUDE.md

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Cross-session handoffs (local, per-machine)
.handoff/

# Test fixtures
test/fixtures/*.mp4
test/fixtures/*.mkv
test/fixtures/*.avi
!test/fixtures/.gitkeep
