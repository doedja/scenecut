{
  "name": "@doedja/scenecut",
  "version": "3.0.1",
  "description": "Scene change detection for Node.js using Xvid's motion estimation algorithm",
  "main": "dist/scenecut.cjs.js",
  "module": "dist/scenecut.esm.js",
  "types": "dist/index.d.ts",
  "bin": {
    "scenecut": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/scenecut.esm.js",
      "require": "./dist/scenecut.cjs.js"
    },
    "./motion-worker": {
      "types": "./dist/motion-worker.d.ts",
      "import": "./dist/motion-worker.mjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:ts": "tsc",
    "build:bundle": "rollup -c",
    "build": "bun run build:ts && bun run build:bundle",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "scene-detection",
    "video",
    "keyframe",
    "xvid",
    "ffmpeg",
    "video-processing",
    "motion-estimation",
    "wasm"
  ],
  "author": "doedja",
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doedja/scenecut.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/doedja/scenecut/issues"
  },
  "homepage": "https://github.com/doedja/scenecut#readme",
  "dependencies": {
    "@doedja/scenecut-core": "workspace:*",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "fluent-ffmpeg": "^2.1.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.10.0",
    "rollup": "^4.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
